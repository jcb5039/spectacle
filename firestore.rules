// [공통-A] Firestore 보안 규칙: 누가 어떤 데이터를 읽고 쓸 수 있는지 정한다. 여기 없는 컬렉션은 모두 막힌다
// B의 후기(reviews)·질문(questions)·답변·좋아요 규칙은 B가 서버에 저장할 때 같이 추가한다.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 가입할 때 인증 상태는 "확인 대기"로만 저장할 수 있다.
    // 학교 이메일 인증은 실제로 메일 링크를 누른 계정(email_verified)만 "인증 완료"로 저장할 수 있다.
    function validNewStatus(data) {
      return data.verificationStatus == 'pending'
        || (data.verificationStatus == 'verified'
            && data.verificationMethod == 'schoolEmail'
            && request.auth.token.email_verified == true);
    }

    // 회원 정보: 휴대폰 번호 등 개인정보가 있어서 본인만 읽고 쓴다.
    // 인증 상태·방법·날짜와 회원 유형은 본인이 바꿀 수 없다 (관리자가 Firebase 콘솔에서 승인)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validNewStatus(request.resource.data);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['verificationStatus', 'verificationMethod', 'verifiedAt', 'memberType']);
      allow delete: if false;
    }

    // 졸업·재학 증명서 사진: 개인정보라 본인만 올리고 볼 수 있다 (관리자는 콘솔에서 확인)
    match /certificates/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 프로필 사진: 로그인한 회원은 볼 수 있고, 본인만 바꿀 수 있다
    match /profilePhotos/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    // ───── 아래는 B: 후기·질문·답변·좋아요 ─────

    // 인증된 취업자(인증 선배)인지: 회원 정보(users)의 유형·인증 상태로 확인한다
    function isVerifiedEmployee() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && exists(path)
        && get(path).data.memberType == 'employee'
        && get(path).data.verificationStatus == 'verified';
    }

    // 새 글: 작성자는 본인이어야 하고, 좋아요 수는 0에서 시작한다
    function validNewPost() {
      return request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('likeCount', 0) == 0;
    }

    // 작성자가 고칠 때: 작성자와 좋아요 수는 바꿀 수 없다
    function ownerEdit() {
      return isOwner(resource.data.authorId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['authorId', 'likeCount']);
    }

    // 좋아요 수만 1 늘리거나 줄인다. 같은 요청에서 내 좋아요 기록(likes)도 함께 생기거나 지워져야 한다
    function likeCountEdit(targetId) {
      let like = /databases/$(database)/documents/likes/$(request.auth.uid + '_' + targetId);
      let before = resource.data.get('likeCount', 0);
      let after = request.resource.data.likeCount;
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && ((after == before + 1 && !exists(like) && existsAfter(like))
          || (after == before - 1 && exists(like) && !existsAfter(like)));
    }

    // 후기: 로그인한 회원은 볼 수 있고, 인증 선배만 쓴다
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if isVerifiedEmployee() && validNewPost();
      allow update: if ownerEdit() || likeCountEdit(reviewId);
      allow delete: if isOwner(resource.data.authorId);
    }

    // 질문: 로그인한 회원 누구나 쓴다
    match /questions/{questionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId']);
      allow delete: if isOwner(resource.data.authorId);
    }

    // 답변: 로그인한 회원은 볼 수 있고, 인증 선배만 쓴다
    match /answers/{answerId} {
      allow read: if signedIn();
      allow create: if isVerifiedEmployee() && validNewPost();
      allow update: if ownerEdit() || likeCountEdit(answerId);
      allow delete: if isOwner(resource.data.authorId);
    }

    // 좋아요 기록: 문서 이름 = "회원id_대상id". 본인 것만 보고, 만들고, 지운다 (같은 글에 두 번 누를 수 없다)
    match /likes/{likeId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.targetId
        && request.resource.data.targetType in ['review', 'answer'];
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
